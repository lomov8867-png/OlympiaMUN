# Copy this file to .env and fill in values for local development.
# In production, set these as real environment variables — do NOT
# commit a populated .env file.

# Port the Express server listens on (default: 3000)
PORT=3000

# Set to "production" on the live server
NODE_ENV=development

# Absolute path to the SQLite database file.
# Leave unset to use the default: backend/data/olympiamun.db
# DB_PATH=/var/data/olympiamun.db

# The URL of your deployed frontend (required in production for CORS).
# In development this is handled automatically; leave unset locally.
# FRONTEND_ORIGIN=https://olympiamun.yourdomain.com
